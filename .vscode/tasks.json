{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "OSTOSENSE: Python unit tests",
      "type": "shell",
      "command": "PYTHONDONTWRITEBYTECODE=1 ../.venv/bin/python -m unittest discover -s ../tests -v",
      "options": {
        "cwd": "${workspaceFolder}/ai/src"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "OSTOSENSE: C++ contract test",
      "type": "shell",
      "command": "g++ -std=c++17 -Wall -Wextra -pedantic -I firmware/include firmware/tests/data_contract_test.cpp -o /tmp/ostosense-data-contract-test && /tmp/ostosense-data-contract-test",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "OSTOSENSE: Verify all contracts",
      "dependsOrder": "sequence",
      "dependsOn": [
        "OSTOSENSE: Python unit tests",
        "OSTOSENSE: C++ contract test"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
