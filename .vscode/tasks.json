{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "OSTOSENSE: Verify",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "scripts/verify.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "OSTOSENSE: Python tests",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-W",
        "error",
        "-m",
        "unittest",
        "discover",
        "-s",
        "ai/tests"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "OSTOSENSE: C++ host tests",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "scripts/verify.py",
        "--cpp-only"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": [
        "$gcc"
      ]
    }
  ]
}
