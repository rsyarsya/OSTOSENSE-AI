{
  "python.defaultInterpreterPath": "${workspaceFolder}/ai/.venv/bin/python",
  "python.testing.unittestEnabled": true,
  "python.testing.pytestEnabled": false,
  "python.testing.unittestArgs": [
    "discover",
    "-s",
    "ai/tests",
    "-v"
  ],
  "C_Cpp.default.includePath": [
    "${workspaceFolder}/firmware/include"
  ],
  "C_Cpp.default.cppStandard": "c++17",
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.backup": true,
    "**/node_modules": true,
    "ai/build": true
  },
  "search.exclude": {
    "ai/.venv": true,
    "ai/build": true,
    "**/.backup": true,
    "**/node_modules": true,
    "**/__pycache__": true
  },
  "python.analysis.exclude": [
    "ai/.venv/**",
    "ai/build/**",
    "**/.backup/**",
    "**/node_modules/**"
  ],
  "python.analysis.extraPaths": [
    "${workspaceFolder}/ai/src"
  ]
}
